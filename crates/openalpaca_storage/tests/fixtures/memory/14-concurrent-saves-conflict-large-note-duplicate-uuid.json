    "agent_two": { "owner_id": "u_example_alice", "workspace": null, "surface": "model_tool", "capabilities": { "read": true, "write": true, "forget": true }, "attribution": { "lane_key": "u_example_alice:telegram", "task_id": null, "request_id": null, "source": "telegram" } },
