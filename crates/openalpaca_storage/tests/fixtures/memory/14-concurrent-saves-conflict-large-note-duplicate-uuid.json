{
  "row": {
    "id": 14,
    "scenario": "Two agent saves; an edit conflict; a large note; a duplicate UUID",
    "required_outcome": "No lost service update; a clear conflict or diagnostic; bounded resources"
  },
  "design": ["§6 Write protocol: one daemon-owned writer queue per partition", "§4 Revisions: expected_revision mandatory; duplicate IDs and oversized records rejected with a visible diagnostic; malformed external files stay on disk, excluded, never rewritten", "§4 Initial limits: note size 32 KiB; explicit tool read response 32 KiB", "§6 Management operations: doctor --repair refuses on a duplicate id and names both files", "§7a memory_store body ≤ 32 KiB; memory_update revision_conflict with current_revision"],
  "loads_in": ["slice-2", "slice-3"],
  "notes_for_implementer": "Step 1 runs two stores at once against one partition and expects both notes recorded — the per-partition writer queue serializes them. Steps 2–5 are the optimistic-concurrency contract: a stale `expected_revision` is `revision_conflict` carrying the current revision, the file is untouched, and the second of two racing edits loses visibly. Steps 6–8 are the size bounds: 32 KiB + 1 byte is refused before anything is written, exactly 32 KiB is accepted, and `memory_read` of it is not truncated. Steps 9–11 are the duplicate id: two hand-dropped files sharing one UUID are both listed by `doctor` as a duplicate, neither is served, neither is rewritten or deleted, and `doctor --repair` refuses naming both files. The generator body sizes are byte counts of the body alone; the frontmatter is on top, and the 32 KiB limit is the note's — the loader must size the body so the whole file is ≤ 32768 bytes in step 7 and > 32768 in step 6 (the `bytes` values leave 600 bytes for the frontmatter).",
  "owners": [
    { "id": "u_example_alice", "owner_key": "32acea7eb739b08afd959db91e46d450" }
  ],
  "database": { "global_users": ["u_example_alice"], "local_user_id": "u_example_alice" },
  "daemon": { "cwd": "home", "llm": "configured" },
