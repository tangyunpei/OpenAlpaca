    { "name": "repo_link_owner", "marker": ".git" },
    { "name": "repo_link_notes", "marker": ".git" },
    { "name": "repo_file_memory", "marker": ".git" }
  ],
  "home_links": [
    { "path": "proj:repo_link_memory/memory", "target": "@dir:outside" },
    { "path": "proj:repo_link_owner/memory/owners/32acea7eb739b08afd959db91e46d450", "target": "@dir:outside" },
    { "path": "proj:repo_link_notes/memory/owners/32acea7eb739b08afd959db91e46d450/notes", "target": "@dir:outside" }
  ],
  "home_files": [
    { "path": "proj:repo_file_memory/memory", "content": "not a directory\n" }
  ],
  "daemon": { "cwd": "home", "llm": "configured" },
  "partitions": [
