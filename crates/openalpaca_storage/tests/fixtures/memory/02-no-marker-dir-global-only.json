      "expect": {
        "refused": "invalid_input",
        "message_contains": ["project"],
        "files_absent": ["ws:plain_dir/.openalpaca"]
      }
    },
    {
      "step": 4,
      "op": "list",
      "context": "cli_in_plain_dir",
      "input": {},
      "expect": { "ids_unordered": ["00000002-0000-4000-8000-000000000001", "@id:fact_here"] }
