      "expect": {
        "created": true,
        "scope": "global",
        "origin": "extracted_user",
        "path_within": { "fact_here": "part:alice_home/notes" },
        "files_absent": ["ws:plain_dir/.openalpaca", "ws:plain_dir/notes-about-nothing/.openalpaca"]
      }
