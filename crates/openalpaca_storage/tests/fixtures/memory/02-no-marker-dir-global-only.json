  "row": {
    "id": 2,
    "scenario": "CLI turn in a directory with no `.openalpaca` or `.git` above it",
    "required_outcome": "Global only; no partition is created there"
  },
  "design": ["§3 rule 1 (MD-5): a workspace with no marker above it reads and writes only the owner's global partition", "§3 rule 2"],
  "loads_in": ["slice-3"],
  "notes_for_implementer": "The workspace `plain_dir` has no marker and sits directly under the temporary root, which has none either (the loader must not create the temporary root inside a git checkout — a `.git` above it would turn the whole root into a project). A `fact` store, whose default scope is project, must land in the home partition, and `plain_dir` must gain no `.openalpaca` directory at all, not even an empty one. Step 3 pins a reading the design leaves implicit: an explicit `scope: project` from a request that resolves no project root is refused as `invalid_input` (design §5 step 1: an unknown or unauthorized root fails closed) rather than silently written to global.",
  "owners": [
    { "id": "u_example_alice", "owner_key": "32acea7eb739b08afd959db91e46d450" }
  ],
  "database": { "global_users": ["u_example_alice"], "local_user_id": "u_example_alice" },
  "workspaces": [
    { "name": "plain_dir", "marker": null, "subdirs": ["notes-about-nothing"] }
  ],
  "daemon": { "cwd": "home", "llm": "configured" },
