{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* Type checking — the project's engineering bar. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    /* Ambient types: browser + Vite client, Vitest globals. Node types are
       deliberately absent here so app code cannot reach for Node APIs; the
       build tooling gets them via tsconfig.node.json. */
    "types": ["vite/client", "vitest/globals"],
    /* No `baseUrl`: TypeScript 7 removed it. Paths resolve relative to this
       file, which 5.x also supports — so this stays valid either way. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.setup.ts"]
}
