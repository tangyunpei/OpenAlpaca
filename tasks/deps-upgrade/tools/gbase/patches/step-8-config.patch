-    let fm: SkillFrontmatter =
-        serde_yaml::from_str(yaml_str).map_err(|e| SkillParseError::InvalidYaml(e.to_string()))?;
+    let fm = parse_yaml(yaml_str)?;
     fm.validate()?;
     Ok(fm)
 }
